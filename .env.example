APP_NAME=PteroBilling
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ptero_billing
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pterodactyl Panel Settings
PTERODACTYL_URL=https://your-panel.com
PTERODACTYL_API_KEY=ptlc_YourApplicationApiKeyHere

# Stripe Payment Gateway
STRIPE_KEY=pk_test_YourStripePublicKey
STRIPE_SECRET=sk_test_YourStripeSecretKey
STRIPE_WEBHOOK_SECRET=whsec_YourWebhookSecret
STRIPE_CURRENCY=usd

# PayPal Payment Gateway
PAYPAL_CLIENT_ID=YourPayPalClientId
PAYPAL_SECRET=YourPayPalSecret
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_NOTIFY_URL=https://yourdomain.com/webhooks/paypal

# Billing Settings
BILLING_CURRENCY=RUB
BILLING_TAX_RATE=0
BILLING_COUPONS_ENABLED=true
